{
  "name": "dsh-tower-ui",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Opt-in Tower Web Client surfaces: tool cards, a persistent Tower-mode chip, mode-aware denied-tool rows, composer dock summary, and a transient overlay status strip.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
