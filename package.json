{
  "name": "dsh-tower",
  "version": "2.0.4",
  "type": "module",
  "description": "DSH-native Tower: mission planning, worktree isolation, review-gated merges, and a human-owned Tower mode.",
  "license": "MIT",
  "author": "Loui Finn",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tower",
    "multi-agent",
    "worktree",
    "code-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louifinn/dsh-tower.git"
  },
  "homepage": "https://github.com/louifinn/dsh-tower#readme",
  "types": "types/index.d.ts",
  "bugs": {
    "url": "https://github.com/louifinn/dsh-tower/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./worker": "./worker.js",
    "./reviewer": "./reviewer.js",
    "./skills": "./skills.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "worker.js",
    "reviewer.js",
    "skills.js",
    "skills/",
    "lib/*.js",
    "lib/domain/*.js",
    "types/",
    "cordis.patch.yml",
    "scripts/",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "COMPATIBILITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/",
    "ui-bundle/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "dev:hmr": "node scripts/enable-dev-hmr.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "architecture:check": "node scripts/architecture.mjs",
    "check": "npm test && npm run docs:check && npm run pack:check && npm run architecture:check"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
