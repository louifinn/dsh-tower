{
  "name": "dsh-tower",
  "version": "2.7.1",
  "type": "module",
  "description": "DSH-native Tower: mission planning, worktree isolation, review-gated merges, and a human-owned Tower mode.",
  "license": "MIT",
  "author": "Loui Finn",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tower",
    "multi-agent",
    "worktree",
    "code-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louifinn/dsh-tower.git"
  },
  "homepage": "https://github.com/louifinn/dsh-tower#readme",
  "types": "types/index.d.ts",
  "bugs": {
    "url": "https://github.com/louifinn/dsh-tower/issues"
  },
  "engines": {
    "node": ">=24.9"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./worker": "./worker.js",
    "./reviewer": "./reviewer.js",
    "./survey": "./survey.js",
    "./survey-sandbox": "./survey-sandbox.js",
    "./skills": "./skills.js",
    "./batch": "./host/capability-batch.js",
    "./import": "./host/capability-import.js",
    "./leases": "./host/capability-leases.js",
    "./tests": "./host/capability-tests.js",
    "./board": "./host/capability-board.js",
    "./archive": "./host/capability-archive.js",
    "./hmr": "./host/capability-hmr.js",
    "./preset-worker": "./host/preset-worker.js",
    "./preset-reviewer": "./host/preset-reviewer.js",
    "./preset-survey": "./host/preset-survey.js",
    "./preset-survey-sandbox": "./host/preset-survey-sandbox.js",
    "./skills/locale/*.json": "./locale/skills/*.json",
    "./batch/locale/*.json": "./locale/batch/*.json",
    "./import/locale/*.json": "./locale/import/*.json",
    "./leases/locale/*.json": "./locale/leases/*.json",
    "./tests/locale/*.json": "./locale/tests/*.json",
    "./board/locale/*.json": "./locale/board/*.json",
    "./archive/locale/*.json": "./locale/archive/*.json",
    "./hmr/locale/*.json": "./locale/hmr/*.json",
    "./preset-worker/locale/*.json": "./locale/preset-worker/*.json",
    "./preset-reviewer/locale/*.json": "./locale/preset-reviewer/*.json",
    "./preset-survey/locale/*.json": "./locale/preset-survey/*.json",
    "./preset-survey-sandbox/locale/*.json": "./locale/preset-survey-sandbox/*.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "index.js",
    "worker.js",
    "reviewer.js",
    "survey.js",
    "survey-sandbox.js",
    "skills.js",
    "skills/",
    "host/*.js",
    "domain/**/*.js",
    "app/*.js",
    "tools/*.js",
    "adapters/*.js",
    "types/",
    "cordis.patch.yml",
    "scripts/",
    "!scripts/check-support.mjs",
    "!scripts/check-workflow.mjs",
    "!scripts/support.json",
    "locale/",
    "icon.svg",
    "README.md",
    "README.en.md",
    "COMPATIBILITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "PRINCIPLES.md",
    "GLOSSARY.md",
    "docs/",
    "!docs/operations/ci.md",
    "ui-bundle/",
    "ports/*.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:property": "node --test tests/property/*.prop.mjs",
    "test:property:long": "node --env-file=tests/property/tiers/long.env --test tests/property/*.prop.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "test:live": "node tests/live/run.cjs",
    "smoke:mount": "node scripts/mount-smoke.mjs",
    "smoke:fixtures": "node scripts/mount-smoke/fixtures.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "audit:issues": "node scripts/issue-audit.mjs",
    "audit:regressions": "node scripts/regression-audit.mjs",
    "surface:check": "node scripts/surface-baseline.mjs",
    "support:check": "node scripts/check-support.mjs",
    "workflow:check": "node scripts/check-workflow.mjs",
    "dev:hmr": "node scripts/enable-dev-hmr.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:check:philosophy": "node scripts/check-philosophy.mjs",
    "docs:generate:errors": "node scripts/generate-error-reference.mjs",
    "docs:check:generated": "node scripts/generate-error-reference.mjs --check",
    "docs:generate:tools": "node scripts/generate-tools-reference.mjs",
    "docs:check:generated:tools": "node scripts/generate-tools-reference.mjs --check",
    "docs:generate:config": "node scripts/generate-config-reference.mjs",
    "docs:check:generated:config": "node scripts/check-config-reference.mjs",
    "docs:generate:events": "node scripts/generate-events-reference.mjs",
    "docs:check:generated:events": "node scripts/generate-events-reference.mjs --check",
    "docs:generate:blockers": "node scripts/generate-blockers-reference.mjs",
    "docs:check:generated:blockers": "node scripts/generate-blockers-reference.mjs --check",
    "blockers:check": "node scripts/check-blockers.mjs",
    "types:generate": "node scripts/generate-types.mjs",
    "docs:check:generated:types": "node scripts/generate-types.mjs --check",
    "docs:generate:components": "node scripts/generate-component-surface.mjs",
    "docs:check:generated:components": "node scripts/generate-component-surface.mjs --check",
    "docs:generate:locale": "node scripts/generate-capability-locale.mjs",
    "docs:check:generated:locale": "node scripts/generate-capability-locale.mjs --check",
    "docs:generate:shapes": "node scripts/generate-shapes-reference.mjs",
    "docs:check:generated:shapes": "node scripts/generate-shapes-reference.mjs --check",
    "shape:audit": "node scripts/shape-audit.mjs",
    "docs:check:components": "node scripts/check-components.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "architecture:check": "node scripts/architecture.mjs",
    "types:check": "tsc --noEmit && tsc -p tsconfig.strict.json",
    "types:coverage": "node scripts/types-coverage.mjs",
    "types:strict:check": "node scripts/types-strict.mjs",
    "types:strict:write": "node scripts/types-strict.mjs --write",
    "check": "npm test && npm run test:property && npm run support:check && npm run workflow:check && npm run docs:check && npm run docs:check:philosophy && npm run docs:check:generated && npm run docs:check:generated:tools && npm run docs:check:generated:config && npm run docs:check:generated:events && npm run docs:check:generated:blockers && npm run docs:check:generated:types && npm run docs:check:generated:components && npm run docs:check:generated:locale && npm run docs:check:generated:shapes && npm run shape:audit && npm run docs:check:components && npm run blockers:check && npm run surface:check && npm run pack:check && npm run architecture:check && npm run types:coverage && npm run types:strict:check && npm run types:check && npm run domain:check",
    "domain:metrics": "node scripts/domain-metrics.mjs",
    "domain:check": "node scripts/domain-metrics.mjs --check"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "typescript": "~5.9.3"
  }
}
