{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ]
  },
  "include": [
    "types/**/*.d.ts",
    "host/**/*.js",
    "tools/**/*.js",
    "adapters/**/*.js",
    "app/**/*.js",
    "domain/**/*.js",
    "ports/**/*.js",
    "index.js",
    "worker.js",
    "reviewer.js",
    "skills.js",
    "tests/type-contracts.ts",
    "tests/tool-schema-types.ts"
  ]
}
