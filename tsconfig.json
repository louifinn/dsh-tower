{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ]
  },
  "include": [
    "types/**/*.d.ts",
    "lib/errors.js",
    "lib/config.js",
    "lib/store.js",
    "lib/git.js",
    "domain/**/*.js",
    "tests/type-contracts.ts",
    "app/*.js",
    "tools/plan.js",
    "tools/schema.js",
    "tools/*.js",
    "adapters/*.js",
    "tests/tool-schema-types.ts"
  ],
  "exclude": [
    "tools/index.js"
  ]
}
