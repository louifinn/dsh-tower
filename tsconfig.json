{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ]
  },
  "include": [
    "types/**/*.d.ts",
    "lib/errors.js",
    "lib/config.js",
    "lib/store.js",
    "lib/git.js",
    "lib/domain/*.js",
    "tests/type-contracts.ts",
    "lib/tower/*.js",
    "lib/tower.js",
    "lib/tools/plan.js",
    "lib/toolSchema.js",
    "lib/tools/*.js",
    "lib/adapters/*.js",
    "tests/tool-schema-types.ts"
  ]
}
