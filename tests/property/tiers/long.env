# Environment for `npm run test:property:long`.
#
# `node --env-file` reads this file before the test runner starts, which is how
# the long tier is selected without a shell-only prefix (it has to work on
# Windows too). An explicit TOWER_PROPERTY_TIER in the caller's environment
# still wins over the npm script name, so this file is the single place that
# turns the long tier on for the long script.
TOWER_PROPERTY_TIER=long
